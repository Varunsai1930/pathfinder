# API
PATHFINDER_ENV=development
# Comma-separated allowed origins. In production, set to the Vercel frontend URL AND localhost:
#   PATHFINDER_CORS_ORIGINS=https://pathfinder-web.vercel.app,http://localhost:5173
PATHFINDER_CORS_ORIGINS=http://localhost:5173

# Supabase — all values from your Supabase project dashboard (Settings > API)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service role key: used by the backend to make privileged PostgREST requests.
# Find it in the Supabase dashboard: Settings > API Keys > service_role (secret).
# This key bypasses RLS — never expose it to the frontend.
SUPABASE_SERVICE_ROLE_KEY=
# JWT verification: primary method uses JWKS (derived from SUPABASE_URL/auth/v1/jwks).
# SUPABASE_JWT_SECRET is optional — used as HS256 fallback during key rotation only.
# It can be removed once JWKS verification is confirmed working in production.
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated

# LLM (used only for validated, grounded explanations, pacing, and Q&A)
OPENAI_API_KEY=
# Official OpenAI model default used by Pathfinder. Override only after testing.
OPENAI_MODEL=gpt-5-mini
